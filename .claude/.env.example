# ============================================================================
# .claude/.env  —  config for the recipe & edit-recipe skills (local, gitignored).
#
# Copy to .claude/.env and fill in your values. Never commit the real .env.
#
# Generate a fresh token (run on either Mac or VPS):
#   openssl rand -hex 32
#
# The same token must be set on the VPS as the RECIPE_API_TOKEN env var
# (typically in /opt/recipe-db/.env, which docker-compose loads automatically).
# ============================================================================

# Public URL of the Flask app on the VPS, no trailing slash.
# Examples:
#   RECIPE_API_URL=https://recipes.example.com
#   RECIPE_API_URL=http://187.77.67.116
RECIPE_API_URL=

# Bearer token used by the recipe & edit-recipe skills to authenticate against
# /api/recipe/* endpoints. Must match the value on the VPS.
RECIPE_API_TOKEN=

# --- veckomeny -------------------------------------------------------------
# How many weeks back the veckomeny skill treats a dish as "recently cooked"
# and avoids suggesting it again. Default 3 if unset.
VECKOMENY_REPEAT_WEEKS=3

# Tailnet host and destination directory for scripts/publish-plan.sh.
# Defaults are nils-rpi and /srv/veckomeny — only set these if they differ.
# VECKOMENY_HOST=nils-rpi
# VECKOMENY_DEST=/srv/veckomeny
# Full tailnet URL used when printing links (port 8443 — 443 is taken).
# VECKOMENY_URL=https://<host>.<tailnet>.ts.net:8443
