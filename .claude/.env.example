# ============================================================================
# .claude/.env  —  config for the recipe & edit-recipe skills (local, gitignored).
#
# Copy to .claude/.env and fill in your values. Never commit the real .env.
#
# The token must match RECIPE_API_TOKEN in recipe-db/.env on the Raspberry Pi
# (nils-rpi), which the Flask container there loads. Never print it.
# ============================================================================

# Flask app on the Pi, no trailing slash. Tailscale address (works anywhere
# on the tailnet); on the home LAN http://192.168.1.82:5001 also works.
# https://recipedb.cloud is the retired VPS (frozen at recipe id 41) — don't use it.
RECIPE_API_URL=http://100.127.88.96:5001

# Bearer token used by the recipe & edit-recipe skills to authenticate against
# /api/recipe/* endpoints. Must match the value on the Pi.
RECIPE_API_TOKEN=
